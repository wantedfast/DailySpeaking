# Server only. Never prefix the key with NEXT_PUBLIC_.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# Build-time URL prefix; empty locally, /dailyspeaking on the shared server.
NEXT_PUBLIC_BASE_PATH=
AI_TIMEOUT_MS=90000
SQLITE_PATH=./data/quotas.sqlite
# Shared originals and knowledge SQLite; keep outside release directories in production.
KNOWLEDGE_DIR=./data/knowledge
# Server only. Empty disables document administration. Use a long unique password.
ADMIN_PASSWORD=
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_DAY=60
RATE_LIMIT_GLOBAL_PER_DAY=500
# Enable only behind a trusted reverse proxy that overwrites X-Real-IP.
# Without a trusted proxy all visitors share the anonymous IP bucket.
TRUST_PROXY=false
# Explicit local fixtures only. Ignored in production; never a fallback.
MOCK_AI=false
# Public hostname for Docker Compose / automatic HTTPS; no scheme or path.
DOMAIN=speak.example.com
